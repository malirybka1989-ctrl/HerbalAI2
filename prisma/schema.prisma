// ─── Development: SQLite —──────────────────────────────────
// For production, switch to PostgreSQL provider and update DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Auth & Users ────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String   @id @default(cuid())
  name               String?
  email              String?  @unique
  emailVerified      DateTime?
  image              String?
  stripeCustomerId   String?  @unique
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  pantry        UserPantry[]
  pantryScans   PantryScan[]
  consultations Consultation[]
  enrollments   Enrollment[]
  savedRituals  SavedRitual[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Subscriptions & Payments ────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  plan                 String    @default("monthly")
  status               String    @default("active")
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Ingredient Database ─────────────────────────────────

model Ingredient {
  id                  String   @id @default(cuid())
  name                String   @unique
  scientificName      String?
  category            String
  tcmProperties       String?
  ayurvedicProperties String?
  folkWisdom          String?
  astrologicalAssoc   String?
  safetyNotes         String?
  contraindications   String?
  imageUrl            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  wellnessSuggestions WellnessSuggestion[]
  userPantries        UserPantry[]
}

model WellnessSuggestion {
  id               String @id @default(cuid())
  ingredientId     String
  tradition        String
  title            String
  description      String
  instructions     String
  safetyDisclaimer String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

// ─── User Pantry & Scans ─────────────────────────────────

model UserPantry {
  id           String   @id @default(cuid())
  userId       String
  ingredientId String
  customName   String?
  quantity     String?
  addedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
}

model PantryScan {
  id               String   @id @default(cuid())
  userId          String
  ingredientsUsed String
  aiResponse      String?
  ritualGenerated Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedRitual {
  id               String   @id @default(cuid())
  userId           String
  pantryScanId     String?
  title            String
  tradition        String
  description      String
  instructions     String
  safetyDisclaimer String?
  ingredients      String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Practitioner & Consultations ────────────────────────

model Practitioner {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  bio             String
  specialty       String
  certifications  String?
  imageUrl        String?
  calendarLink    String?
  pricePerSession Float    @default(0)
  currency        String   @default("EUR")
  isActive        Boolean  @default(true)
  rating          Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultations Consultation[]
}

model Consultation {
  id              String    @id @default(cuid())
  userId          String
  practitionerId  String
  status          String    @default("pending")
  scheduledAt     DateTime?
  meetingLink     String?
  notes           String?
  stripePaymentId String?
  amount          Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  practitionerId  String
  consultationId  String   @unique
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())
}

// ─── Courses & Learning ──────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  price       Float    @default(0)
  currency    String   @default("EUR")
  imageUrl    String?
  videoUrl    String?
  duration    Int?
  category    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  videoUrl    String?
  duration    Int?
  orderIndex  Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}