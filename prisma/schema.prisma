// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  image             String?
  stripeCustomerId  String?  @unique
  onboardingComplete Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  pantry        UserPantry[]
  pantryScans   PantryScan[]
  consultations Consultation[]
  enrollments   Enrollment[]
  savedRituals  SavedRitual[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Subscriptions & Payments ────────────────────────────

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  plan            String   @default("monthly") // monthly | yearly
  status          String   @default("active")  // active | canceled | past_due | incomplete
  stripeSubscriptionId String? @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Ingredient Database ─────────────────────────────────

model Ingredient {
  id               String   @id @default(cuid())
  name             String   @unique
  scientificName   String?
  category         String   // Spice, Herb, Fruit, Vegetable, Household, Other
  tcmProperties    Json?    // { nature, taste, meridians }
  ayurvedicProperties Json? // { dosha, guna }
  folkWisdom       String?  @db.Text
  astrologicalAssoc String?
  safetyNotes      String?  @db.Text
  contraindications Json?   // [{ condition, severity }]
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wellnessSuggestions WellnessSuggestion[]
  userPantries        UserPantry[]

  @@map("ingredients")
}

model WellnessSuggestion {
  id               String @id @default(cuid())
  ingredientId     String
  tradition        String // TCM, Ayurveda, Folk, Astrology, Acupressure
  title            String
  description      String @db.Text
  instructions     String @db.Text
  safetyDisclaimer String? @db.Text

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("wellness_suggestions")
}

// ─── User Pantry & Scans ─────────────────────────────────

model UserPantry {
  id           String   @id @default(cuid())
  userId       String
  ingredientId String
  customName   String?  // For ingredients not in our DB
  quantity     String?  // e.g., "1 piece", "2 tbsp"
  addedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
  @@map("user_pantries")
}

model PantryScan {
  id              String   @id @default(cuid())
  userId          String
  ingredientsUsed Json     // Array of ingredient names used
  aiResponse      Json?    // Full AI response JSON
  ritualGenerated Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pantry_scans")
}

model SavedRitual {
  id               String   @id @default(cuid())
  userId           String
  pantryScanId     String?
  title            String
  tradition        String
  description      String  @db.Text
  instructions     String  @db.Text
  safetyDisclaimer String? @db.Text
  ingredients      Json    // Array of ingredient names
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_rituals")
}

// ─── Practitioner & Consultations ────────────────────────

model Practitioner {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  bio             String   @db.Text
  specialty       String   // TCM, Herbalist, Astrologer, Acupuncturist
  certifications  String?  @db.Text
  imageUrl        String?
  calendarLink    String?  // Calendly or similar
  pricePerSession Float    @default(0)
  currency        String   @default("EUR")
  isActive        Boolean  @default(true)
  rating          Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultations Consultation[]

  @@map("practitioners")
}

model Consultation {
  id              String   @id @default(cuid())
  userId          String
  practitionerId  String
  status          String   @default("pending") // pending | confirmed | completed | canceled
  scheduledAt     DateTime?
  meetingLink     String?
  notes           String?  @db.Text
  stripePaymentId String?
  amount          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@map("consultations")
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  practitionerId  String
  consultationId  String   @unique
  rating          Int      // 1-5
  comment         String?  @db.Text
  createdAt       DateTime @default(now())

  @@map("reviews")
}

// ─── Courses & Learning ──────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  price       Float    @default(0)
  currency    String   @default("EUR")
  imageUrl    String?
  videoUrl    String?
  duration    Int?     // in minutes
  category    String?  // Herbal, Astrology, TCM, Meditation, Acupressure
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?  @db.Text
  videoUrl    String?
  duration    Int?     // in minutes
  orderIndex  Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Float     @default(0) // 0.0 - 100.0
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}